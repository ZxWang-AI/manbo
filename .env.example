# Local development defaults. This file contains placeholders only.
NODE_ENV=development
APP_MODE=normal
DATABASE_URL=postgresql://manbo:manbo_test@127.0.0.1:55432/manbo_test?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters

# The mock provider is for local development only. Production must use gateway.
AI_PROVIDER=mock
# Optional local/staging encrypted material store; never enable this mode in production.
# MATERIAL_OBJECT_STORE=local
# MATERIAL_OBJECT_STORE_ROOT=D:\\Manbo\\private-materials
# MATERIAL_OBJECT_STORE_MASTER_KEY=replace-with-64-hex-characters
# MATERIAL_OBJECT_STORE_KEY_VERSION=local-kek-v1
# AI_PROVIDER=gateway
# AI_GATEWAY_URL=https://gateway.example.invalid
# AI_GATEWAY_TOKEN=replace-with-a-secret-token
# AI_MODEL_ALIAS=review-model
# AI_REGION=replace-with-region
# AI_RETENTION_POLICY_ID=reviewed:no-training

# Optional provider-neutral isolated media gateway (staging/production only).
# The gateway must be HTTPS and use a reviewed retention policy. The worker
# sends material bytes and detected MIME/container metadata, never filenames or
# case/account identifiers. Leave unset to keep the fail-closed scanner/parser.
# MATERIAL_SECURITY_GATEWAY=isolated
# MATERIAL_SECURITY_GATEWAY_URL=https://media-gateway.example.invalid
# MATERIAL_SECURITY_GATEWAY_TOKEN=replace-with-a-secret-token
# MATERIAL_SECURITY_RETENTION_POLICY_ID=reviewed:no-training
# MATERIAL_SECURITY_GATEWAY_TIMEOUT_MS=15000
# MATERIAL_SECURITY_GATEWAY_MAX_RESPONSE_BYTES=2097152

# Durable material worker (staging/production process only; keep disabled for web requests).
# MATERIAL_PROCESSING_WORKER_ENABLED=false
# MATERIAL_PROCESSING_WORKER_ID=material-worker-01
# MATERIAL_PROCESSING_IDLE_DELAY_MS=1000
# MATERIAL_PROCESSING_QUEUE=durable
# Durable workers use a 60-second lease and renew it halfway through long tasks.

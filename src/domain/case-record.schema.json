{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "const": "private"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "exported",
        "deleted"
      ]
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "jurisdiction": {
      "type": "object",
      "properties": {
        "incidentCountry": {
          "type": "string",
          "minLength": 1
        },
        "userCountry": {
          "type": "string",
          "minLength": 1
        },
        "productDestination": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "sourceMessageIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceQuote": {
            "type": "string",
            "minLength": 1
          },
          "certainty": {
            "type": "string",
            "enum": [
              "user_stated",
              "uncertain"
            ]
          }
        },
        "required": [
          "id",
          "field",
          "value",
          "sourceMessageIds",
          "sourceQuote",
          "certainty"
        ],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sourceMessageIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "description",
          "sourceMessageIds"
        ],
        "additionalProperties": false
      }
    },
    "iloIndicators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "indicatorId": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              },
              {
                "type": "number",
                "const": 5
              },
              {
                "type": "number",
                "const": 6
              },
              {
                "type": "number",
                "const": 7
              },
              {
                "type": "number",
                "const": 8
              },
              {
                "type": "number",
                "const": 9
              },
              {
                "type": "number",
                "const": 10
              },
              {
                "type": "number",
                "const": 11
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "hit",
              "not_hit",
              "insufficient"
            ]
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "conversation",
                    "knowledge"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "indicatorId",
          "status",
          "basis",
          "missing"
        ],
        "additionalProperties": false
      }
    },
    "elements": {
      "type": "object",
      "properties": {
        "workOrService": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "covered",
                "partial",
                "unknown"
              ]
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "conversation",
                      "knowledge"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "basis",
            "missing"
          ],
          "additionalProperties": false
        },
        "involuntary": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "covered",
                "partial",
                "unknown"
              ]
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "conversation",
                      "knowledge"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "basis",
            "missing"
          ],
          "additionalProperties": false
        },
        "penaltyOrThreat": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "covered",
                "partial",
                "unknown"
              ]
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "conversation",
                      "knowledge"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "id"
                ],
                "additionalProperties": false
              }
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "basis",
            "missing"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "workOrService",
        "involuntary",
        "penaltyOrThreat"
      ],
      "additionalProperties": false
    },
    "evidenceCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "entity_facility",
              "timeline",
              "work_relationship",
              "coercive_conduct",
              "pay_hours",
              "product_flow",
              "supporting_material"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "covered",
              "partial",
              "gap"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "sourceMessageIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "safeOptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "topic",
          "status",
          "explanation",
          "sourceMessageIds",
          "safeOptions"
        ],
        "additionalProperties": false
      }
    },
    "legalNavigation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "jurisdiction": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "possible",
              "needs_review",
              "not_covered"
            ]
          },
          "premise": {
            "type": "string",
            "minLength": 1
          },
          "lastVerified": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "stale": {
            "type": "boolean"
          },
          "officialUrl": {
            "allOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "pattern": "^https:\\/\\/"
              }
            ]
          }
        },
        "required": [
          "jurisdiction",
          "sourceId",
          "status",
          "premise",
          "lastVerified",
          "stale"
        ],
        "additionalProperties": false
      }
    },
    "referrals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "officialUrl": {
            "allOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "string",
                "pattern": "^https:\\/\\/"
              }
            ]
          },
          "anonymity": {
            "type": "string",
            "enum": [
              "supported",
              "not_supported",
              "unknown"
            ]
          },
          "feedback": {
            "type": "string",
            "enum": [
              "expected",
              "not_expected",
              "unknown"
            ]
          },
          "userSteps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "sourceId",
          "name",
          "officialUrl",
          "anonymity",
          "feedback",
          "userSteps"
        ],
        "additionalProperties": false
      }
    },
    "safetyFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "violence",
          "confinement",
          "self_harm",
          "minor",
          "trafficking"
        ]
      }
    },
    "sourceTrace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "conversation",
              "knowledge"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "consent": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "saveCase": {
          "type": "boolean"
        },
        "externalSharing": {
          "type": "boolean"
        },
        "confirmedFieldPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "version",
        "saveCase",
        "externalSharing",
        "confirmedFieldPaths"
      ],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "deletedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "aiReviewStatus": {
      "type": "string",
      "enum": [
        "ready_for_preparation",
        "needs_more_information",
        "out_of_scope",
        "safety_referral"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "accountId",
    "visibility",
    "lifecycle",
    "version",
    "jurisdiction",
    "facts",
    "timeline",
    "iloIndicators",
    "elements",
    "evidenceCoverage",
    "legalNavigation",
    "referrals",
    "safetyFlags",
    "sourceTrace",
    "consent",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
